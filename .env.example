# Copy this file to .env and fill in your real values.
# .env itself must NEVER be committed — it's already in .gitignore.

# --- Razorpay test-mode credentials ---
# Get these from: Razorpay Dashboard -> Settings -> API Keys (make sure "Test Mode" toggle is ON)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# --- Groq API key ---
# Get this from: https://console.groq.com -> API Keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx

# --- Which Groq model to use ---
# openai/gpt-oss-120b recommended for reliable structured JSON output
# (llama-3.3-70b-versatile was deprecated by Groq mid-project — see docs/what_broke.md)
GROQ_MODEL=openai/gpt-oss-120b

# --- Webhook (filled in once ngrok is running, Day 5) ---
# Example: https://abcd-1234.ngrok-free.app/webhook/razorpay
RAZORPAY_WEBHOOK_URL=
RAZORPAY_WEBHOOK_SECRET=
